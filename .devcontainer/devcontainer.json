{
  "name": "simple-html-cpp",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "ms-vscode.cpptools-extension-pack"
      ]
    }
  },
  "containerEnv": {
    "TERM": "xterm-256color"
  },
  "remoteUser": "root"
}
